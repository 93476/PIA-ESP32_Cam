<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pia_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PIA" android:textColor="@color/pia_text" android:textSize="34sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_subtitle" android:textColor="@color/pia_muted" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvPiaConnection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="10dp"
                android:text="PIA: comprobando…" android:textColor="@color/pia_muted" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabMonitor"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="MONITOREO"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabCamera"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="CÁMARA"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/monitorContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pia_surface" app:cardCornerRadius="18dp"
                app:strokeColor="@color/pia_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ESTADO GENERAL" android:textColor="@color/pia_muted" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvGeneralState" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="ESTADO: --" android:textColor="@color/pia_warning"
                        android:textSize="24sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pia_surface" app:cardCornerRadius="18dp"
                app:strokeColor="@color/pia_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Monitoreo" android:textColor="@color/pia_text" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTemperature" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Temperatura: --" android:textColor="@color/pia_text" android:textSize="17sp"/>
                    <TextView android:id="@+id/tvHumidity" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Humedad: --" android:textColor="@color/pia_text" android:textSize="17sp"/>
                    <TextView android:id="@+id/tvPresence" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Presencia: --" android:textColor="@color/pia_text" android:textSize="17sp"/>
                    <TextView android:id="@+id/tvDistance" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Distancia: --" android:textColor="@color/pia_text" android:textSize="17sp"/>
                    <TextView android:id="@+id/tvImpact" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Impacto: --" android:textColor="@color/pia_text" android:textSize="17sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pia_surface" app:cardCornerRadius="18dp"
                app:strokeColor="@color/pia_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Emergencia" android:textColor="@color/pia_text" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvSms" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="SMS automático: --" android:textColor="@color/pia_text" android:textSize="16sp"/>
                    <TextView android:id="@+id/tvCall" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Llamada automática: --" android:textColor="@color/pia_text" android:textSize="16sp"/>
                    <TextView android:id="@+id/tvPresenceTime" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Tiempo con presencia: --" android:textColor="@color/pia_text" android:textSize="16sp"/>
                    <TextView android:id="@+id/tvCallCountdown" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Llamada automática en: --" android:textColor="@color/pia_text" android:textSize="16sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pia_surface" app:cardCornerRadius="18dp"
                app:strokeColor="@color/pia_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Control" android:textColor="@color/pia_text" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvNetworkInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Red PIA: --" android:textColor="@color/pia_muted" android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSendSms"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/send_sms"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCall"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="@string/call"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnReset"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="@string/reset_alerts"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/settings"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:id="@+id/cameraContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pia_surface" app:cardCornerRadius="18dp"
                app:strokeColor="@color/pia_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cámara del vehículo" android:textColor="@color/pia_text"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="La cámara usa un segundo ESP32 en la misma red WiFi. Configura su IP en Ajustes."
                        android:textColor="@color/pia_muted" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvCameraConnection" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="Cámara: preparada" android:textColor="@color/pia_muted" android:textStyle="bold"/>
                    <WebView android:id="@+id/webCamera" android:layout_width="match_parent"
                        android:layout_height="300dp" android:layout_marginTop="10dp" android:background="#000000"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnReloadCamera"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="@string/camera_reload"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCameraSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Configurar IP de cámara"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>